{
	"name": "brukthallen",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"pwa:assets": "pwa-asset-generator src/lib/assets/favicon.svg --manifest static/manifest.json static/pwa --path-override '/pwa",
		"pwa:index": "pwa-asset-generator src/lib/assets/favicon.svg --manifest static/manifest.json --index src/lib/components/PWA.svelte --path-override '/pwa' static/pwa"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"pwa-asset-generator": "^8.1.4",
		"svelte": "^5.54.0",
		"tailwindcss": "^4.1.18",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@sveltejs/enhanced-img": "^0.10.4"
	}
